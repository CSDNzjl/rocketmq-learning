<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven 项目描述文件（pom.xml）
  小白理解：这里声明「用哪个 Spring Boot、依赖哪些 jar、怎么打包」。
  阶段4 新增：Spring Cloud Stream + RocketMQ Binder（和 fom-daq 一样用 binding 名发/收）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>rocketmq-springboot-demo</artifactId>
  <version>1.0.0</version>
  <description>Minimal Spring Boot RocketMQ producer/consumer demo</description>

  <properties>
    <java.version>17</java.version>
    <rocketmq-spring.version>2.3.1</rocketmq-spring.version>
    <!-- Spring Boot 3.2.x 对应 Spring Cloud 2023.0.x -->
    <spring-cloud.version>2023.0.3</spring-cloud.version>
    <!-- 与 Cloud 2023.0 配套的 Alibaba（内含 stream-rocketmq binder） -->
    <spring-cloud-alibaba.version>2023.0.1.2</spring-cloud-alibaba.version>
  </properties>

  <!-- 统一管理 Spring Cloud / Alibaba 版本，避免 binder 和 Boot 打架 -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.alibaba.cloud</groupId>
        <artifactId>spring-cloud-alibaba-dependencies</artifactId>
        <version>${spring-cloud-alibaba.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      阶段1～3：RocketMQ 官方 Spring 起步依赖（直连 Topic）
      提供 RocketMQTemplate、@RocketMQMessageListener
    -->
    <dependency>
      <groupId>org.apache.rocketmq</groupId>
      <artifactId>rocketmq-spring-boot-starter</artifactId>
      <version>${rocketmq-spring.version}</version>
    </dependency>

    <!--
      阶段4：Spring Cloud Stream + RocketMQ Binder（对齐 fom-daq）
      代码里用 binding 名 demoCollect-out-0 / demoCollect-in-0，
      真正 Topic 写在 application.yml 的 destination。
    -->
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-stream-rocketmq</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
