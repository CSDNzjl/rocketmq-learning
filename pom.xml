<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven 项目描述文件（pom.xml）
  小白对照：声明用哪个版本的 Spring Boot、依赖哪些 jar、怎么打包运行。
  阶段4 起引入 Spring Cloud Stream + RocketMQ Binder（与 fom-daq 一样用 binding 发送/收）。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.5</version>
    <relativePath/>
  </parent>

  <groupId>com.example</groupId>
  <artifactId>rocketmq-springboot-demo</artifactId>
  <version>1.0.0</version>
  <description>Minimal Spring Boot RocketMQ producer/consumer demo</description>

  <properties>
    <java.version>17</java.version>
    <rocketmq-spring.version>2.3.1</rocketmq-spring.version>
    <!-- Spring Boot 3.2.x 对应 Spring Cloud 2023.0.x -->
    <spring-cloud.version>2023.0.3</spring-cloud.version>
    <!-- 与 Cloud 2023.0 配套的 Alibaba（含 stream-rocketmq binder） -->
    <spring-cloud-alibaba.version>2023.0.1.2</spring-cloud-alibaba.version>
    <!-- 阶段 XXL-JOB：执行器核心包版本（公司二次封装 com.kocel，非官方 com.xuxueli） -->
    <xxl-job.version>5.0.0-RELEASE</xxl-job.version>
  </properties>

  <!-- 统一管理 Spring Cloud / Alibaba 版本，避免 binder 与 Boot 冲突 -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.alibaba.cloud</groupId>
        <artifactId>spring-cloud-alibaba-dependencies</artifactId>
        <version>${spring-cloud-alibaba.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      阶段1～3：RocketMQ 官方 Spring 起步依赖，直连 Topic。
      提供 RocketMQTemplate、@RocketMQMessageListener
    -->
    <dependency>
      <groupId>org.apache.rocketmq</groupId>
      <artifactId>rocketmq-spring-boot-starter</artifactId>
      <version>${rocketmq-spring.version}</version>
    </dependency>

    <!--
      阶段4：Spring Cloud Stream + RocketMQ Binder（对齐 fom-daq）。
      代码里用 binding 名 demoCollect-out-0 / demoCollect-in-0，
      真正 Topic 写在 application.yml 的 destination。
    -->
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-stream-rocketmq</artifactId>
    </dependency>

    <!--
      阶段 XXL-JOB：执行器核心依赖（@XxlJob / XxlJobSpringExecutor）
      对齐线上 Admin / scheduletask：com.kocel:xxl-job-core:5.0.0-RELEASE（公司二次封装）。
      线上 TriggerParam.jobId / logId 为 String（雪花 ID），官方 2.4.1 的 int 会 NumberFormatException。
      需能解析公司私服（settings.xml localRepository=D:/ifom_repository）。
    -->
    <dependency>
      <groupId>com.kocel</groupId>
      <artifactId>xxl-job-core</artifactId>
      <version>${xxl-job.version}</version>
    </dependency>

    <!--
      公司 xxl-job-core 5.0.0 GlueFactory 需要 groovy.lang.GroovyClassLoader。
      其 pom 声明 org.codehaus.groovy:groovy:3.0.8；此处用 Boot 3.2 对齐的 org.apache.groovy:4.0.21。
    -->
    <dependency>
      <groupId>org.apache.groovy</groupId>
      <artifactId>groovy</artifactId>
      <version>4.0.21</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
